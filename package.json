{
  "name": "book-to-voice",
  "version": "0.4.6",
  "private": true,
  "description": "A local-first book reader with natural neural narration.",
  "engines": { "node": ">=22" },
  "scripts": {
    "launch": "node tools/launch.js",
    "supervisor": "node tools/supervisor.js",
    "start": "node server.js",
    "voice:setup": "node tools/narration/setup.js",
    "voice:setup:gpu": "node tools/narration/setup-gpu.js",
    "test": "node --test tests/*.test.js",
    "release:zip": "node tools/release.js",
    "convert": "node tools/books/convert.js",
    "tunnel": "node tools/books/tunnel.js"
  }
}
